// Niri compositor. @baseXX@ placeholders are Stylix palette colours, filled in
// and checked with `niri validate` by niri.nix at build time.

input {
    keyboard {
        xkb {
            layout "us"
        }
        numlock
    }

    touchpad {
        tap
        dwt
        natural-scroll
    }

    mouse {
        accel-profile "flat"
    }

    focus-follows-mouse max-scroll-amount="0%"
    warp-mouse-to-focus
}

output "HDMI-A-2" {
    mode "3440x1440@99.982"
    scale 1

    // VRR only while a window that asks for it (the steam_app rule below) is on
    // screen. Inert on HDMI: Pascal drives G-Sync Compatible over DisplayPort only.
    variable-refresh-rate on-demand=true
}

layout {
    gaps 12
    center-focused-column "on-overflow"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-gradient from="@base0D@" to="@base0C@" angle=45
        inactive-color "@base02@"
    }

    border {
        off
    }

    shadow {
        on
        softness 24
        spread 3
        offset x=0 y=5
        color "#00000070"
    }
}

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot %Y-%m-%d %H-%M-%S.png"

animations {
    slowdown 0.85
}

hotkey-overlay {
    skip-at-startup
}

// Lets Noctalia's notification actions raise the window that sent them.
debug {
    honor-xdg-activation-with-invalid-serial
}

// Noctalia's blurred wallpaper copy fills the overview backdrop.
layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}

window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}

window-rule {
    match app-id=r#"^dev\.noctalia\.Noctalia$"#
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

window-rule {
    match app-id=r#"^(org\.pulseaudio\.pavucontrol|pavucontrol|blueman-manager|\.blueman-manager-wrapped|org\.gnome\.FileRoller)$"#
    open-floating true
}

window-rule {
    match app-id=r#"(?i)^\.?dzgui"#
    open-floating true
    open-focused true
}

window-rule {
    match title="^Picture-in-Picture$"
    open-floating true
}

// Steam draws its own toast windows (title notificationtoasts_<n>_desktop).
// Keep them out of the tiling layout and away from focus, bottom-right.
window-rule {
    match app-id="^steam$" title="^notificationtoasts_"
    open-floating true
    open-focused false
    default-floating-position x=20 y=20 relative-to="bottom-right"
}

// Proton games run through xwayland-satellite as steam_app_<id>.
window-rule {
    match app-id=r#"^steam_app_[0-9]+$"#
    variable-refresh-rate true
}

binds {
    // Each Tern window owns its own sessions, so a second window opens an empty
    // "Default" one; raise the existing window and launch only when there is none.
    // Tern lives in ~/.local/bin, which is on shell PATHs only.
    Mod+Return repeat=false hotkey-overlay-title="Terminal (Tern)" { spawn-sh "niri-focus-or-spawn so.stencil.tern ~/.local/bin/tern"; }
    Mod+B repeat=false hotkey-overlay-title="Browser" { spawn "firefox"; }
    Mod+E repeat=false hotkey-overlay-title="Files" { spawn "thunar"; }
    Mod+Shift+G repeat=false hotkey-overlay-title="Steam" { spawn "steam"; }
    Mod+Shift+V repeat=false hotkey-overlay-title="Virtual machines" { spawn "virt-manager"; }
    Mod+Ctrl+T repeat=false hotkey-overlay-title="System monitor" { spawn-sh "~/.local/bin/tern -e btop"; }

    Mod+Space repeat=false hotkey-overlay-title="Application launcher" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+Ctrl+Space repeat=false hotkey-overlay-title="Control center" { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+Ctrl+V repeat=false hotkey-overlay-title="Clipboard history" { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }
    Mod+Ctrl+D repeat=false hotkey-overlay-title="Shell settings" { spawn "noctalia" "msg" "settings-toggle"; }
    Mod+Ctrl+L repeat=false hotkey-overlay-title="Lock screen" { spawn "noctalia" "msg" "session" "lock"; }
    Mod+Shift+E repeat=false hotkey-overlay-title="Power/session menu" { spawn "noctalia" "msg" "panel-toggle" "session"; }
    Alt+Tab repeat=false hotkey-overlay-title="Window switcher" { spawn "noctalia" "msg" "window-switcher" "hold"; }
    Mod+Ctrl+Shift+E { quit; }

    Mod+O repeat=false hotkey-overlay-title="Overview" { toggle-overview; }
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Q repeat=false { close-window; }
    Mod+W repeat=false { close-window; }
    Mod+T repeat=false { toggle-window-floating; }
    Mod+F repeat=false { fullscreen-window; }
    Mod+Shift+F repeat=false { maximize-column; }
    Mod+Shift+W repeat=false { toggle-column-tabbed-display; }

    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-or-workspace-down; }
    Mod+Up    { focus-window-or-workspace-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-or-workspace-down; }
    Mod+K     { focus-window-or-workspace-up; }
    Mod+L     { focus-column-right; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Down  { move-window-down-or-to-workspace-down; }
    Mod+Shift+Up    { move-window-up-or-to-workspace-up; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+J     { move-window-down-or-to-workspace-down; }
    Mod+Shift+K     { move-window-up-or-to-workspace-up; }
    Mod+Shift+L     { move-column-right; }

    Mod+Ctrl+Shift+Left  { move-window-to-monitor-left; }
    Mod+Ctrl+Shift+Down  { move-window-to-monitor-down; }
    Mod+Ctrl+Shift+Up    { move-window-to-monitor-up; }
    Mod+Ctrl+Shift+Right { move-window-to-monitor-right; }
    Mod+Ctrl+Shift+H     { move-window-to-monitor-left; }
    Mod+Ctrl+Shift+J     { move-window-to-monitor-down; }
    Mod+Ctrl+Shift+K     { move-window-to-monitor-up; }
    Mod+Ctrl+Shift+L     { move-window-to-monitor-right; }

    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-workspace-down; }
    Mod+Ctrl+Page_Up   { move-workspace-up; }
    Mod+Tab { focus-workspace-previous; }

    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Shift+WheelScrollUp { focus-column-left; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }

    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Mod+C { center-column; }
    Mod+Ctrl+C { center-visible-columns; }

    Print { screenshot; }
    Shift+Print { screenshot-window; }
    Ctrl+Print { screenshot-screen; }
    Mod+Shift+S { screenshot; }
    Mod+Alt+S { screenshot-window; }
    Mod+Ctrl+S { screenshot-screen; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+P { power-off-monitors; }
}
