{ config, inputs, ... }:
let
  homeModules = config.flake.modules.homeManager;
in
{
  flake.modules.homeManager.rex =
    { lib, pkgs, ... }:
    {
      imports = [ inputs.rex.homeManagerModules.default ];

      programs.rex = {
        enable = true;
        # ~/.ssh/config is user-managed rather than generated by programs.ssh.
        sshGuard = false;
      };

      # Personal Rex server as a systemd user service on Linux (no GUI yet;
      # on macOS the Rex.app GUI runs its own server).
      services.rex.enable = lib.mkIf pkgs.stdenv.hostPlatform.isLinux true;
    };

  flake.modules.darwin.rex = {
    home-manager.sharedModules = [ homeModules.rex ];
  };

  flake.modules.nixos.rex =
    { config, ... }:
    {
      # Keep the user systemd service running across logouts and at boot.
      users.users.${config.my.user}.linger = true;

      home-manager.sharedModules = [ homeModules.rex ];
    };
}
