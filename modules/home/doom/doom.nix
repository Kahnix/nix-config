{ inputs, ... }:
{
  # Doom Emacs beside Helix (hx stays EDITOR), built by
  # nix-doom-emacs-unstraightened: Doom, its modules and every package they
  # pull in are pinned by flake.lock and built into the store, so there is no
  # straight.el, no `doom sync` and no mutable ~/.config/emacs. The DOOMDIR is
  # ./doomdir; editing it takes effect on the next rebuild.
  flake.modules.homeManager.dev =
    {
      config,
      lib,
      osConfig,
      pkgs,
      ...
    }:
    let
      isWsl = osConfig.wsl.enable or false;
      stylix = config.stylix.enable or false;

      # Same font as Stylix's monospace; the "Mono" family has one-cell icons.
      font = if stylix then config.stylix.fonts.monospace.name else "BerkeleyMono Nerd Font";
      fontSize = if stylix then config.stylix.fonts.sizes.applications else 11;

      # Stylix's base16 palette as an Emacs theme, the same way Stylix's own
      # emacs target builds it (that target only reaches programs.emacs).
      base16-stylix-theme =
        epkgs:
        epkgs.trivialBuild (
          with config.lib.stylix.colors.withHashtag;
          {
            pname = "base16-stylix-theme";
            version = "0.1.0";
            src = pkgs.writeText "base16-stylix-theme.el" ''
              ;;; base16-stylix-theme.el -*- lexical-binding: t; -*-
              (require 'base16-theme)

              (defvar base16-stylix-theme-colors
                '(:base00 "${base00}" :base01 "${base01}" :base02 "${base02}" :base03 "${base03}"
                  :base04 "${base04}" :base05 "${base05}" :base06 "${base06}" :base07 "${base07}"
                  :base08 "${base08}" :base09 "${base09}" :base0A "${base0A}" :base0B "${base0B}"
                  :base0C "${base0C}" :base0D "${base0D}" :base0E "${base0E}" :base0F "${base0F}"))

              (deftheme base16-stylix)
              (base16-theme-define 'base16-stylix base16-stylix-theme-colors)
              (provide-theme 'base16-stylix)

              (add-to-list 'custom-theme-load-path
                           (file-name-directory (file-truename load-file-name)))

              (provide 'base16-stylix-theme)
            '';
            packageRequires = [ epkgs.base16-theme ];
          }
        );

      # Loaded by doomdir/config.el. WSL has no Stylix, so it falls back to
      # doom-themes' Gruvbox.
      nixEl = pkgs.writeText "nix.el" (
        ''
          ;;; nix.el --- generated by modules/home/doom/doom.nix -*- lexical-binding: t; -*-
          (setq doom-font (font-spec :family "${font}" :size ${toString (fontSize * 1.0)})
                nerd-icons-font-family "${font} Mono")
        ''
        + (
          if stylix then
            ''
              (setq doom-variable-pitch-font (font-spec :family "${config.stylix.fonts.sansSerif.name}")
                    base16-theme-256-color-source 'colors)
              (require 'base16-stylix-theme)
              (setq doom-theme 'base16-stylix)
            ''
          else
            ''
              (setq doom-theme 'doom-gruvbox)
            ''
        )
      );
    in
    {
      imports = [ inputs.nix-doom-emacs-unstraightened.homeModule ];

      programs.doom-emacs = {
        enable = true;

        doomDir = pkgs.runCommandLocal "doomdir" { } ''
          cp -r ${./doomdir} $out
          chmod u+w $out
          cp ${nixEl} $out/nix.el
        '';

        # pgtk renders natively on niri (Wayland); WSL is terminal-only.
        emacs =
          if pkgs.stdenv.hostPlatform.isDarwin then
            pkgs.emacs
          else if isWsl then
            pkgs.emacs-nox
          else
            pkgs.emacs-pgtk;

        # Matches how Unstraightened's Cachix cache is built, so packages Doom
        # pins can be substituted (see modules/system/nix.nix).
        experimentalFetchTree = true;

        # Every grammar nixpkgs packages, for the +tree-sitter module flags;
        # otherwise Doom would try to compile them into ~/.local at runtime.
        extraPackages =
          epkgs:
          [ epkgs.treesit-grammars.with-all-grammars ] ++ lib.optional stylix (base16-stylix-theme epkgs);

        # Eglot and apheleia only find servers and formatters on Emacs's PATH,
        # and a GUI Emacs started from the Dock or niri does not get the login
        # shell's. Reuses Helix's toolchain plus the servers dev.nix installs
        # for every editor.
        extraBinPackages = [
          config.programs.git.package
          pkgs.ripgrep
          pkgs.fd
        ]
        ++ config.programs.helix.extraPackages
        ++ (with pkgs; [
          nil
          nixd
          nixfmt
          lua-language-server
          typescript
          typescript-language-server
          vscode-langservers-extracted
          yaml-language-server
        ]);
      };
    };
}
