{ inputs, ... }:
{
  # Doom Emacs beside Helix (hx stays EDITOR), built by
  # nix-doom-emacs-unstraightened: Doom, its modules and every package they
  # pull in are pinned by flake.lock and built into the store, so there is no
  # straight.el, no `doom sync` and no mutable ~/.config/emacs. The DOOMDIR is
  # ./doomdir; editing it takes effect on the next rebuild.
  flake.modules.homeManager.dev =
    {
      config,
      lib,
      osConfig,
      pkgs,
      ...
    }:
    let
      isWsl = osConfig.wsl.enable or false;
      stylix = config.stylix.enable or false;
      # macOS daemon socket; see launchd.agents.emacs below. Its own directory:
      # Emacs creates it 0700 and refuses one others can read (~/.cache/emacs).
      emacsSocket = "${config.xdg.cacheHome}/emacs-server/server";

      # Same font as Stylix's monospace; the "Mono" family has one-cell icons.
      font = if stylix then config.stylix.fonts.monospace.name else "BerkeleyMono Nerd Font";
      fontSize = if stylix then config.stylix.fonts.sizes.applications else 11;

      # Stylix's base16 palette as an Emacs theme, the same way Stylix's own
      # emacs target builds it (that target only reaches programs.emacs).
      base16-stylix-theme =
        epkgs:
        epkgs.trivialBuild (
          with config.lib.stylix.colors.withHashtag;
          {
            pname = "base16-stylix-theme";
            version = "0.1.0";
            src = pkgs.writeText "base16-stylix-theme.el" ''
              ;;; base16-stylix-theme.el -*- lexical-binding: t; -*-
              (require 'base16-theme)

              (defvar base16-stylix-theme-colors
                '(:base00 "${base00}" :base01 "${base01}" :base02 "${base02}" :base03 "${base03}"
                  :base04 "${base04}" :base05 "${base05}" :base06 "${base06}" :base07 "${base07}"
                  :base08 "${base08}" :base09 "${base09}" :base0A "${base0A}" :base0B "${base0B}"
                  :base0C "${base0C}" :base0D "${base0D}" :base0E "${base0E}" :base0F "${base0F}"))

              (deftheme base16-stylix)
              (base16-theme-define 'base16-stylix base16-stylix-theme-colors)
              (provide-theme 'base16-stylix)

              (add-to-list 'custom-theme-load-path
                           (file-name-directory (file-truename load-file-name)))

              (provide 'base16-stylix-theme)
            '';
            packageRequires = [ epkgs.base16-theme ];
          }
        );

      # Where nixd, Emacs's Nix language server, finds nixpkgs and this
      # machine's option sets: the flake checkout and the configuration name
      # from modules/home/dev.nix (keep the host names in sync with it).
      flakePath = "${config.home.homeDirectory}/nix-config";
      nixdSystem =
        if pkgs.stdenv.hostPlatform.isDarwin then
          "darwinConfigurations.macbook-pro-m4"
        else if isWsl then
          "nixosConfigurations.wsl"
        else
          "nixosConfigurations.nixos";
      nixdOptions = if pkgs.stdenv.hostPlatform.isDarwin then "nix-darwin" else "nixos";

      # Loaded by doomdir/config.el. WSL has no Stylix, so it falls back to
      # doom-themes' Gruvbox.
      nixEl = pkgs.writeText "nix.el" (
        ''
          ;;; nix.el --- generated by modules/home/doom/doom.nix -*- lexical-binding: t; -*-
          (setq doom-font (font-spec :family "${font}" :size ${toString (fontSize * 1.0)})
                nerd-icons-font-family "${font} Mono")
        ''
        + (
          if stylix then
            ''
              (setq doom-variable-pitch-font (font-spec :family "${config.stylix.fonts.sansSerif.name}")
                    base16-theme-256-color-source 'colors)
              (require 'base16-stylix-theme)
              (setq doom-theme 'base16-stylix)
            ''
          else
            ''
              (setq doom-theme 'doom-gruvbox)
            ''
        )
        + ''
          ;; nixd asks the client for its settings over
          ;; workspace/configuration; the only default is `import <nixpkgs>',
          ;; and the daemon has no NIX_PATH, so package completion and the
          ;; version hints came up empty.  Same expressions as
          ;; modules/home/dev.nix gives Helix.
          (setq-default
           eglot-workspace-configuration
           '(:nixd
             (:nixpkgs (:expr "import (builtins.getFlake \"${flakePath}\").inputs.nixpkgs { }")
              :formatting (:command ["nixfmt"])
              :options
              (:${nixdOptions}
               (:expr "(builtins.getFlake \"${flakePath}\").${nixdSystem}.options")
               :home-manager
               (:expr "(builtins.getFlake \"${flakePath}\").${nixdSystem}.options.home-manager.users.type.getSubOptions [ ]")))))
        ''
      );
    in
    {
      imports = [ inputs.nix-doom-emacs-unstraightened.homeModule ];

      programs.doom-emacs = {
        enable = true;

        doomDir = pkgs.runCommandLocal "doomdir" { } ''
          cp -r ${./doomdir} $out
          chmod u+w $out
          cp ${nixEl} $out/nix.el
        '';

        # pgtk renders natively on niri (Wayland); WSL is terminal-only.
        emacs =
          if pkgs.stdenv.hostPlatform.isDarwin then
            pkgs.emacs
          else if isWsl then
            pkgs.emacs-nox
          else
            pkgs.emacs-pgtk;

        # Matches how Unstraightened's Cachix cache is built, so packages Doom
        # pins can be substituted (see modules/system/nix.nix).
        experimentalFetchTree = true;

        # Every grammar nixpkgs packages, for the +tree-sitter module flags;
        # otherwise Doom would try to compile them into ~/.local at runtime.
        # emrex (github:Kahnix/emrex, the `emrex` flake input) makes windows of
        # Emacs frames in Rex panes into Rex panes; doomdir/config.el turns it on.
        extraPackages =
          epkgs:
          [
            epkgs.treesit-grammars.with-all-grammars
            (inputs.emrex.lib.mkEmrex epkgs)
          ]
          ++ lib.optional stylix (base16-stylix-theme epkgs);

        # Eglot and apheleia only find servers and formatters on Emacs's PATH,
        # and the daemon (launchd on macOS) or a GUI Emacs started from the Dock
        # does not get the login shell's. Reuses Helix's toolchain plus the
        # servers dev.nix installs for every editor; direnv for envrc, rustup
        # for its rust-analyzer proxy.
        extraBinPackages = [
          config.programs.git.package
          pkgs.ripgrep
          pkgs.fd
        ]
        ++ config.programs.helix.extraPackages
        ++ (with pkgs; [
          config.programs.direnv.package
          rustup
          nil
          nixd
          nixfmt
          lua-language-server
          # Runs several language servers behind one Eglot connection
          # (TypeScript + oxlint, see doomdir/config.el).
          # shortcut: rass 0.3.5 (and upstream master) sends
          # `previousResultId: null` on its first diagnostics pull, which
          # TypeScript 7's server rejects, so type errors never arrive. Omit
          # the key until a pull has returned an id; drop once fixed upstream.
          (rassumfrassum.overrideAttrs (prev: {
            postPatch = (prev.postPatch or "") + ''
              substituteInPlace src/rassumfrassum/frassum.py \
                --replace-fail \
                  "'previousResultId': state.inflight_pulls.get(id(server))," \
                  "**({'previousResultId': p} if (p := state.inflight_pulls.get(id(server))) is not None else {}),"
            '';
          }))
          typescript
          typescript-language-server
          vscode-langservers-extracted
          yaml-language-server
        ]);
      };

      # One long-lived Emacs per login (launchd agent on macOS, systemd user
      # service on Linux), so startup and Doom's lazy loading are paid once;
      # Unstraightened sets services.emacs.package to the Doom build. On Linux
      # a rebuild does not restart it (unsaved buffers); `systemctl --user
      # restart emacs` picks up a new build. On macOS, activation reloads the
      # agent whenever the build changes, restarting Emacs (unsaved buffers
      # are lost; auto-save files stay).
      services.emacs = {
        enable = true;
        # niri imports WAYLAND_DISPLAY into the systemd user session; starting
        # before that would give a daemon that cannot open pgtk frames.
        startWithUserSession = if isWsl then true else "graphical";
        client.enable = !isWsl;
      };

      # launchd starts the agent without TMPDIR, so the daemon would put its
      # socket in /tmp/emacs<uid>/ while emacsclient looks under $TMPDIR
      # (/var/folders/...). Give both the same path. Linux needs nothing:
      # systemd sets XDG_RUNTIME_DIR for the service and the shell alike.
      launchd.agents.emacs.config.ProgramArguments = lib.mkIf pkgs.stdenv.hostPlatform.isDarwin (
        lib.mkForce [
          "${config.services.emacs.package}/bin/emacs"
          "--fg-daemon=${emacsSocket}"
        ]
      );
      home.sessionVariables = lib.mkIf pkgs.stdenv.hostPlatform.isDarwin {
        EMACS_SOCKET_NAME = emacsSocket;
      };

      # Clients open instantly once the daemon is up: `e` in the terminal,
      # `ec` as a GUI frame (returns the shell immediately).
      programs.fish.shellAliases = {
        e = "emacsclient -t";
        ec = "emacsclient -c -n";
      };
    };
}
